<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>EasyOcrSharp.Cli</RootNamespace>
		<AssemblyName>EasyOcrSharp.Cli</AssemblyName>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>easyocrsharp</ToolCommandName>
		<PackageId>EasyOcrSharp.Cli</PackageId>
		<Version>3.0.0</Version>
		<Authors>Farhan Lodi</Authors>
		<Description>Command-line OCR powered by EasyOcrSharp — EasyOCR's neural models on ONNX Runtime, no Python required. Scans images, PDFs, globs and folders to text, JSON, hOCR, ALTO or TSV, writes searchable PDFs, and pre-pulls models for air-gapped deployment.</Description>
		<PackageTags>OCR;EasyOCR;ONNX;CLI;dotnet-tool;TextRecognition;hOCR;ALTO;SearchablePDF;.NET10</PackageTags>
		<RepositoryUrl>https://github.com/FarhanLodi/EasyOcrSharp</RepositoryUrl>
		<PackageProjectUrl>https://github.com/FarhanLodi/EasyOcrSharp</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReleaseNotes>3.0.0: Tracks EasyOcrSharp 3.0.0. The imaging stack moves to EasyImageSharp and the PP-StructureV3 document-structure engine is now built into EasyOcrSharp rather than coming from the third-party PaddleOcrNet package, so no split-licensed dependency remains anywhere in the graph. Models are served from the EasyOcrSharp model repository and cached in one directory shared with the library (%LOCALAPPDATA%/EasyOcrSharp/models), so structure models re-download once after upgrading. No command, flag, output format or exit code changed.</PackageReleaseNotes>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<UseWindowsForms>false</UseWindowsForms>
		<UseWPF>false</UseWPF>
		<SupportedOSPlatforms>Windows;Linux;macOS</SupportedOSPlatforms>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\EasyOcrSharp\EasyOcrSharp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="EasyOcrSharp.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="" />
		<None Include="../../LICENSE" Pack="true" PackagePath="" />
		<None Include="../../NOTICE" Pack="true" PackagePath="" />
		<None Include="../EasyOcrSharp/Assets/icon.png" Pack="true" PackagePath="icon.png" />
	</ItemGroup>

	<!--
	  A dotnet tool is installed with `dotnet tool install -g` and runs on a desktop or server. The
	  ONNX Runtime package also ships iOS and Android native binaries (onnxruntime.xcframework.zip and
	  onnxruntime.aar), which can never execute in that context but were 106 MB of a 169 MB package -
	  downloaded by every user on every install. Every desktop RID (win/linux/osx, x64/x86/arm64) is
	  kept, so the tool still runs everywhere it ran before, from the same single package.
	-->
	<Target Name="TrimMobileRuntimeAssets"
	        AfterTargets="ComputeResolvedFilesToPublishList"
	        BeforeTargets="_HandlePublishFilesForTool">
		<ItemGroup>
			<ResolvedFileToPublish
				Remove="@(ResolvedFileToPublish)"
				Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/android/')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes\android\'))
				        Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/ios/')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes\ios\'))" />
		</ItemGroup>
	</Target>

</Project>
