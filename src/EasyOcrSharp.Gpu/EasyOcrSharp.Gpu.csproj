<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PackageId>EasyOcrSharp.Gpu</PackageId>
		<Version>3.2.0</Version>
		<Authors>Farhan Lodi</Authors>
		<Description>CUDA GPU execution provider for EasyOcrSharp. Adds Microsoft.ML.OnnxRuntime.Gpu so detection and recognition run on NVIDIA GPUs.</Description>
		<PackageTags>OCR;EasyOCR;ONNX;GPU;CUDA;.NET10</PackageTags>
		<RepositoryUrl>https://github.com/FarhanLodi/EasyOcrSharp</RepositoryUrl>
		<PackageProjectUrl>https://github.com/FarhanLodi/EasyOcrSharp</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>
		<NeutralLanguage>en-US</NeutralLanguage>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../EasyOcrSharp/EasyOcrSharp.csproj" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="" />
		<None Include="../../NOTICE" Pack="true" PackagePath="" />
		<None Include="../EasyOcrSharp/Assets/icon.png" Pack="true" PackagePath="icon.png" />
		<!--
			Imported into the consuming project by NuGet. Ensures the GPU build of onnxruntime.dll is the
			copy that reaches the output folder, instead of the CPU one EasyOcrSharp's own ONNX Runtime
			dependency contributes (see the comment in the targets file).
		-->
		<None Include="buildTransitive/EasyOcrSharp.Gpu.targets" Pack="true" PackagePath="buildTransitive/" />
	</ItemGroup>

</Project>
